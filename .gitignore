images
/libexec*
/.libexec*

# Ignore the configuration files
/config.yaml
/registry-auth.json

# --- Helper & Build Scripts ---
# Generated helper scripts (downloaded dynamically)
build-scripts/
helper-scripts/

# --- Documentation (Sphinx) ---
docs/_build/
docs/build/

# --- Modgen (Module Generation) ---
apps
apps-modules
ref
ref-modules

